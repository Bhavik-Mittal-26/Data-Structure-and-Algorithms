class Solution {
public:
    vector<int> findMissingAndRepeatedValues(vector<vector<int>>& grid) {
        vector<int> ans;
        unordered_map<int, int> mp;

        int n = grid.size();

        for(int i = 0; i < n; i++) {
            for(int j = 0; j < n; j++) {
                mp[grid[i][j]]++;
            }
        }

        int repeated = -1;
        int missing = -1;

        for(int i = 1; i <= n*n; i++) {
            if(mp[i] == 2) {
                repeated = i;
            }
            else if(mp[i] == 0) {
                missing = i;
            }
        }

        ans.push_back(repeated);
        ans.push_back(missing);

        return ans;
    }
};